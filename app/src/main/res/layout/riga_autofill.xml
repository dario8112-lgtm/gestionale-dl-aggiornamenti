<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="#FFFFFF" android:padding="10dp">
    <ImageView android:id="@+id/icona" android:layout_width="28dp" android:layout_height="28dp"
        android:src="@mipmap/ic_launcher" android:layout_marginEnd="10dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/titolo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#1E3A5F" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/sotto" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="#555555" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>
